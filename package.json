{
  "name": "event-logger",
  "version": "1.0.0",
  "description": "Event logging system with real-time dashboard",
  "private": true,
  "workspaces": [
    "packages/*",
    "api",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=api & npm run dev --workspace=web",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "db:up": "docker-compose up -d",
    "db:down": "docker-compose down",
    "db:logs": "docker-compose logs -f postgres",
    "migrate": "npm run migrate --workspace=api",
    "seed": "npm run seed --workspace=api"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  }
}
